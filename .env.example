# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app1dXnj3CwDlL5Hj
AIRTABLE_TABLE=Clients

# Sanity (one project shared across all clients; per-client dataset
# lives on the Airtable Clients row, not in env. Required from PR #2.)
SANITY_PROJECT_ID=
SANITY_TOKEN=
SANITY_API_VERSION=2024-10-01

# Sanity Studio (only needed when running `pnpm sanity:dev` or
# deploying the Studio. Dataset list is comma-separated and drives
# the workspace switcher inside Studio.)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASETS=

# OpenRouter (universal /v1/chat/completions; works for any model
# OpenRouter exposes — Anthropic, OpenAI, Google, Mistral, xAI, etc).
# Get a key from https://openrouter.ai/keys. Model IDs use the
# `provider/model` format, e.g. anthropic/claude-sonnet-4.6,
# openai/gpt-5, google/gemini-2.5-pro.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4.6

# Runtime
DRY_RUN=true
LOG_LEVEL=info
